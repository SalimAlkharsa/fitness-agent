# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Google service account: a file path locally, OR the full key JSON on one line
# (required for `make deploy` — the function gets it as an env var)
GOOGLE_SA_JSON=./service-account.json

# The target spreadsheet's ID (the long token in its URL)
SHEET_ID=

# Shared passphrase that gates the chat page
PASSPHRASE=

# Secret used to sign the auth cookie (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=

# URL prefix the deployed function serves under — empty for local dev; after the
# first deploy set it from `make url` (e.g. /api/v1/web/fn-xxxx/fitness/app)
# and deploy again. See deploy/RUNBOOK.md.
BASE_PATH=

# Namespace access key (id:secret) for async /chat self-invoke on DO Functions.
# Deploy-only — leave blank locally (async stays off, /chat runs synchronously).
# Get it from ~/.config/doctl/sandbox/creds/*/credentials.json after connecting.
DO_FN_AUTH=

# --- Strava mirror (optional; leave blank to turn it off) ---
# Create an API app at https://www.strava.com/settings/api with Authorization
# Callback Domain = localhost, then run `python -m app.strava auth` for the token.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Optional, sensible defaults in app/config.py ---
# LLM model id served through OpenRouter
# MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Fallback paid model if the eval gates against the free tier
# FALLBACK_MODEL=
# Tool-calling mode: "native" (default) or "json"
# TOOL_MODE=native
# Local dev only: skip real OpenRouter calls and serve canned agent replies, so
# you can poke the UI/flows without spending the free-tier quota. `make dev-dry`
# sets this for you. Leave unset (or 0) in any real/deployed environment.
# DRY_RUN=1
